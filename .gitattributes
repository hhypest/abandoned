* text=auto
*.md text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.csv text eol=lf
*.ps1 text eol=lf
# Unified diff context prefixes a tab-indented source line with a space.
Scripts/EnginePatches/*.patch text eol=lf whitespace=-space-before-tab

*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
