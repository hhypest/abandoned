+bool TryKeepMapPage(void* Page)
+{
+	if (!bTravelTrim || !ReserveOpen.load(std::memory_order_acquire))
+	{
+		return false;
+	}
+	FScopeLock Lock(&ReserveLock);
+	if (!ReserveOpen.load(std::memory_order_relaxed) || Admitted == ReserveLimit)
+	{
+		return false;
+	}
+	ReservePages[Available++] = Page;
+	++Admitted;
+	return true;
+}
+
+void* TryUseMapPage(uint32 Alignment)
+{
+	if (!ReserveOpen.load(std::memory_order_acquire))
+	{
+		return nullptr;
+	}
+	FScopeLock Lock(&ReserveLock);
+	for (int32 Index = Available - 1; Index >= 0; --Index)
+	{
+		void* Page = ReservePages[Index];
+		if (Alignment == 0 || IsAligned(Page, Alignment))
+		{
+			ReservePages[Index] = ReservePages[--Available];
+			return Page;
+		}
+	}
+	return nullptr;
+}
+
+static void CloseReserve(const TCHAR* Reason)
+{
+	if (!ReserveOpen.load(std::memory_order_acquire))
+	{
+		return;
+	}
+	void* Unused[MaxReservePages];
+	int32 Retained, Remaining;
+	{
+		FScopeLock Lock(&ReserveLock);
+		if (!ReserveOpen.exchange(false, std::memory_order_acq_rel))
+		{
+			return;
+		}
+		Retained = Admitted;
+		Remaining = Available;
+		FMemory::Memcpy(Unused, ReservePages, Remaining * sizeof(void*));
+		Available = Admitted = 0;
+	}
+	TGuardValue<int32*> Ignore(AuditedPageFrees, nullptr);
+	for (int32 Index = 0; Index < Remaining; ++Index)
+	{
+		FMemory::Free(Unused[Index]);
+	}
+	UE_LOG(LogTemp, Display, TEXT("MapPageReserve close=%s admitted=%d served=%d released=%d"),
+		Reason, Retained, Retained - Remaining, Remaining);
+}
+
+void FMapPageTrimExperiment::StartMap(bool bWeight)
+{
+	if (!bMeasureReserve)
+	{
+		return;
+	}
+	CloseReserve(TEXT("new-map"));
+	WeightFrame = bWeight ? EWeightFrame::Loading : EWeightFrame::Idle;
+	bTrackWeight = bWeight;
+	if (bWeight && ReserveLimit)
+	{
+		FScopeLock Lock(&ReserveLock);
+		ReserveOpen.store(true, std::memory_order_release);
+	}
+}
+
+void FMapPageTrimExperiment::Loaded()
+{
+	if (bTrackWeight)
+	{
+		WeightFrame = EWeightFrame::WaitForBegin;
+		bTrackWeight = false;
+	}
+}
+
+static void BeginWeightFrame()
