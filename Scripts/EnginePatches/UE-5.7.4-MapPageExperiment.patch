+#if !UE_BUILD_SHIPPING
+namespace UE::MemStack
+{
+thread_local bool* AuditedHeapMiss = nullptr;
+thread_local int32* AuditedPageFrees = nullptr;
+static thread_local FPageAllocator::TPageAllocator** DeferTo = nullptr;
+static std::atomic<bool> bCountPages{false};
+static bool bDeferDrain = false;
+
+static void Drain(FPageAllocator::TPageAllocator& Pool)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MemStack_TrimFreePages);
+	if (!bCountPages.load(std::memory_order_relaxed))
+	{
+		Pool.Trim();
+		return;
+	}
+	int32 Released = 0;
+	{
+		TGuardValue<int32*> Observe(AuditedPageFrees, &Released);
+		Pool.Trim();
+	}
+	TCHAR Label[48];
+	FCString::Snprintf(Label, UE_ARRAY_COUNT(Label), TEXT("MemStackDrain/%d"), Released);
+	TRACE_CPUPROFILER_EVENT_SCOPE_TEXT(Label);
+}
+
+void FMapPageTrimExperiment::DuringWorldTrim(TFunctionRef<void()> Trim)
+{
+	TGuardValue<FPageAllocator::TPageAllocator**> Guard(DeferTo, bDeferDrain ? &Pending : nullptr);
+	Trim();
+}
+
+FMapPageTrimExperiment::~FMapPageTrimExperiment()
+{
+	if (Pending)
+	{
+		TRACE_CPUPROFILER_EVENT_SCOPE(MemStack_EndOfLoadMapDrain);
+		Drain(*Pending);
+	}
+}
+}
+#endif
